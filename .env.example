# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Required only for the scripts that call Together AI. The offline paths —
# the results walkthrough notebook, the test suite, scripts/analyze_dataset.py,
# and scripts/regenerate_results.py --source archive --explainer-source archive —
# need no key at all.
TOGETHER_API_KEY=

# --- docker compose -------------------------------------------------------
# Bearer token a caller presents to the orchestrator (/verify and its A2A route).
# This is the one handed to whoever calls the deployed service.
ORCHESTRATOR_TOKEN=change-me-public

# Bearer token the agents require of each other. Kept separate from the public
# one so a leaked public token cannot drive the specialist agents directly.
AGENT_TOKEN=change-me-internal

# Optional. Weight on the fine-tuned predictor when both answer (log-odds pool).
# 1.0 defers entirely to it.
POOL_WEIGHT=1.0

# Optional. Ceiling on statements per /verify request; requests above it are
# refused rather than truncated.
MAX_POINTS=50

# Optional. Only used to format trace ids for a Google Cloud Logging backend.
GOOGLE_CLOUD_PROJECT=
