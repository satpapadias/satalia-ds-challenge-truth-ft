# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# --- GCP & Vertex AI Configuration ---
# Required for Vertex AI inference and Cloud Logging.
GOOGLE_CLOUD_PROJECT="x-wppai-researchlab-wpptestbed"
GOOGLE_CLOUD_LOCATION="us-central1"

# --- Model Endpoints ---
# Fine-Tuned Vertex AI endpoint ID or Resource Name
TRUTHCLF_FT_MODEL="projects/221040857484/locations/us-central1/endpoints/4351713640865333248"

# Zero-shot baseline model ID
TRUTHCLF_ZEROSHOT_MODEL="gemini-2.5-flash"

# --- Service Authentication (Local / docker-compose) ---
# Bearer token a caller presents to the orchestrator (/verify route)
ORCHESTRATOR_TOKEN="change-me-public"

# Internal bearer token used for Agent-to-Agent (A2A) communication
AGENT_TOKEN="change-me-internal"

# --- Pipeline Behavior ---
# Weight on the fine-tuned predictor when both answer (log-odds pool). 1.0 defers to it.
POOL_WEIGHT=1.0

# Maximum number of statements per /verify request.
# NOTE: Set to a lower value (e.g., 2) for local testing to avoid SSE stream limits.
MAX_POINTS=2

# --- Agent Timeouts (seconds) ---
PREDICTOR_TIMEOUT_S=120
EXPLAINER_TIMEOUT_S=600